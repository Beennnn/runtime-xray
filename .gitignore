target/
*.class
*.log
.idea/
*.iml
.vscode/
.DS_Store

# Enregistrements JFR : binaires, ~10 Mo pour 10 s d'exécution, illisibles hors JMC,
# et leur contenu aléatoire déclenche le scanner de secrets de GitHub (faux positif
# « Grafana token » constaté le 2026-08-20). Les extraits texte, eux, sont versionnés.
*.jfr

# Clés de licence : jamais dans le dépôt (il est public, et git garde l'historique).
# Elles vivent hors arborescence git — voir docs/etude/cles-evaluation.md
*.license
*.key
licence*.sh
license*.sh
.env.local

# Sorties d'exécution : c'est le répertoire de sortie PAR DÉFAUT de l'outil, donc celui
# où atterrit une analyse lancée depuis un clone du dépôt. Un rapport porte les noms de
# classes, les numéros de ligne et les VALEURS DE PARAMÈTRES du code analysé : lancé sur
# une application réelle, il n'a rien à faire dans un dépôt public. Ignoré pour qu'aucun
# `git add -A` ne puisse l'y mettre. Les exécutions de démonstration conservées comme
# pièces de l'étude sont dans reports-demo/executions/, hors de ce chemin.
runtime-xray-out/
