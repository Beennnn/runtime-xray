<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.beennnn</groupId>
    <artifactId>runtime-xray</artifactId>
    <version>1.2.2</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>runtime-xray-cli</artifactId>
  <packaging>jar</packaging>

  <name>Runtime X-Ray CLI</name>
  <description>
    The orchestrator: launches a Java application under observation, fetches the analysis
    components from a Maven repository, and assembles their outputs into a single page.
    NO dependency outside the JDK — that is the point: the tool must run where the
    application runs, and a machine that executes Java has a JDK, not necessarily bash or
    Python.
  </description>
  <url>https://github.com/Beennnn/runtime-xray</url>

  <!--
    The three components' versions. They serve only the "complet" profile, which must embed
    exactly what Toolbox will go looking for: ToolboxTest checks that they do not diverge
    from the code's constants, the only source of truth at run time.
  -->
  <properties>
    <jacoco.version>0.8.13</jacoco.version>
    <arthas.version>4.3.4</arthas.version>
    <async.version>4.1</async.version>
  </properties>

  <dependencies>
    <!-- Test scope only: the delivered jar stays with no dependency at all. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>runtime-xray</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>lab.xray.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The complete edition: the same tool, with its three analysis components embedded,
      extracted to ~/.runtime-xray at first launch.

      A single file to carry onto a closed machine, where the ordinary jar supposes the cache
      has been prepared. It is not the default build: the ordinary jar weighs 170 KB and
      redistributes nothing, this one weighs 19 MB and redistributes EPL-2.0 and Apache-2.0
      (see THIRD-PARTY.md). Two artefacts, two audiences.

          mvn -Pcomplet -DskipTests package
          → orchestrator/target/runtime-xray-complet.jar
    -->
    <profile>
      <id>complet</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>composants</id>
                <phase>prepare-package</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <!-- The destination names are the ones Toolbox recomposes: the embedded
                       jar must be findable exactly like the one in the cache. -->
                  <outputDirectory>${project.build.directory}/complet/lab/xray/composants</outputDirectory>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.jacoco</groupId>
                      <artifactId>org.jacoco.agent</artifactId>
                      <version>${jacoco.version}</version>
                      <classifier>runtime</classifier>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.jacoco</groupId>
                      <artifactId>org.jacoco.cli</artifactId>
                      <version>${jacoco.version}</version>
                      <classifier>nodeps</classifier>
                    </artifactItem>
                    <artifactItem>
                      <groupId>tools.profiler</groupId>
                      <artifactId>async-profiler</artifactId>
                      <version>${async.version}</version>
                    </artifactItem>
                    <artifactItem>
                      <groupId>tools.profiler</groupId>
                      <artifactId>jfr-converter</artifactId>
                      <version>${async.version}</version>
                    </artifactItem>
                    <artifactItem>
                      <groupId>com.taobao.arthas</groupId>
                      <artifactId>arthas-packaging</artifactId>
                      <version>${arthas.version}</version>
                      <classifier>bin</classifier>
                      <type>zip</type>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>classes-du-complet</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/complet</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.outputDirectory}</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>complet</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classesDirectory>${project.build.directory}/complet</classesDirectory>
                  <classifier>complet</classifier>
                  <archive>
                    <manifest>
                      <mainClass>lab.xray.Main</mainClass>
                    </manifest>
                  </archive>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      The light edition: only JaCoCo is embedded, so 900 KB instead of 18 MB. Arthas weighs
      three quarters of the complete edition on its own, for capturing values that not
      everybody needs; the coverage, for its part, is what one wants almost always. The times
      and the values stay obtainable by the other paths.

      The profile repeats the previous one's machinery: sharing it would demand an activation
      by property, which Maven does not honour from another profile.

          mvn -Pjacoco -DskipTests package
          → orchestrator/target/runtime-xray-jacoco.jar
    -->
    <profile>
      <id>jacoco</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>composants</id>
                <phase>prepare-package</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/jacoco/lab/xray/composants</outputDirectory>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.jacoco</groupId>
                      <artifactId>org.jacoco.agent</artifactId>
                      <version>${jacoco.version}</version>
                      <classifier>runtime</classifier>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.jacoco</groupId>
                      <artifactId>org.jacoco.cli</artifactId>
                      <version>${jacoco.version}</version>
                      <classifier>nodeps</classifier>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>classes-du-jacoco</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/jacoco</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.build.outputDirectory}</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>jacoco</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classesDirectory>${project.build.directory}/jacoco</classesDirectory>
                  <classifier>jacoco</classifier>
                  <archive>
                    <manifest>
                      <mainClass>lab.xray.Main</mainClass>
                    </manifest>
                  </archive>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
