<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.beennnn</groupId>
    <artifactId>runtime-xray</artifactId>
    <version>1.2.2</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sample-app</artifactId>
  <packaging>jar</packaging>

  <name>sample-app</name>
  <description>
    The target application analysed by all the tools. The business code has no dependency
    at all: what a profiler displays must come from THIS code, not from a framework's noise.

    Three dependencies exist nevertheless, each one to show a case the local code cannot
    produce:
      - commons-lang3: code to analyse that comes NOT from a directory of classes but from a
        jar, like an internal dependency delivered compiled;
      - slf4j-api + slf4j-simple: a library outside the JDK, visible in the call tree, and
        one that we want to be able to hide by configuration.
  </description>

  <properties>
    <exec.mainClass>lab.sample.Main</exec.mainClass>
    <!-- This module is the study's demonstration support. It is of interest only in this
         repository: publishing it under a permanent namespace would add an artefact nobody
         could ever withdraw.

         TWO properties, and both are necessary. maven.deploy.skip stops the standard deploy;
         it is NOT enough, because the Central publishing plugin builds its bundle on its own
         side — verified: sample-app was in it despite the skip. It is skipPublishing that
         takes it out. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <commons-lang3.version>3.17.0</commons-lang3.version>
    <slf4j.version>2.0.17</slf4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>${commons-lang3.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>sample-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${exec.mainClass}</mainClass>
              <!-- The dependencies stay SEPARATE jars, beside ours, rather than melted into
                   a single one. This is deliberate: the study needs a stable path to a
                   dependency's jar in order to give it to be analysed
                   (CLASSES_DIR="target/classes:target/libs/commons-lang3-x.y.z.jar").
                   An uber-jar would erase precisely the distinction we want to show. -->
              <addClasspath>true</addClasspath>
              <classpathPrefix>libs/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copier-les-dependances</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
