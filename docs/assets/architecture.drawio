<mxfile host="app.diagrams.net" type="device"><diagram name="Overall architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="NO NETWORK ACCESS WHILE IT RUNS" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F2F5F6;strokeColor=#8896A2;strokeWidth=1.3;dashed=1;dashPattern=8 6;verticalAlign=top;align=right;spacingRight=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1000" height="860" as="geometry"/></mxCell><mxCell id="n3" value="Acceptance&amp;#10;or taking over code" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#E8ECEF;strokeColor=#3E444A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="240" height="60" as="geometry"/></mxCell><mxCell id="n4" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="292" y="110" width="36" height="36" as="geometry"/></mxCell><mxCell id="n5" value="&amp;lt;b&amp;gt;Orchestrator&amp;lt;/b&amp;gt;&amp;#10;runtime-xray.jar&amp;#10;instruments nothing, profiles nothing — no dependency outside the Java Development Kit" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#A3196F;strokeWidth=3.2;fontColor=#A3196F;fontStyle=1;verticalAlign=middle;spacingLeft=54;align=left;" vertex="1" parent="1"><mxGeometry x="220" y="220" width="360" height="90" as="geometry"/></mxCell><mxCell id="n6" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="232" y="245" width="40" height="40" as="geometry"/></mxCell><mxCell id="n7" value="OBSERVED JAVA VIRTUAL MACHINE" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#E7EBEE;strokeColor=#8896A2;strokeWidth=1.3;dashed=1;dashPattern=8 6;verticalAlign=top;align=right;spacingRight=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="100" y="380" width="560" height="250" as="geometry"/></mxCell><mxCell id="n8" value="&amp;lt;b&amp;gt;Analysed application&amp;lt;/b&amp;gt;&amp;#10;sample-app.jar&amp;#10;22 classes, no dependency" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;spacingLeft=44;align=left;" vertex="1" parent="1"><mxGeometry x="130" y="420" width="260" height="70" as="geometry"/></mxCell><mxCell id="n9" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="140" y="435" width="34" height="34" as="geometry"/></mxCell><mxCell id="n10" value="All three measure the SAME run.&amp;lt;br&amp;gt;&amp;lt;b&amp;gt;None answers all three questions.&amp;lt;/b&amp;gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5B6873;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="410" y="430" width="230" height="60" as="geometry"/></mxCell><mxCell id="n11" value="&amp;lt;b&amp;gt;JaCoCo&amp;lt;/b&amp;gt; — agent — the executed lines" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;spacingLeft=36;align=left;fontColor=#0B7A6E;" vertex="1" parent="1"><mxGeometry x="130" y="510" width="500" height="34" as="geometry"/></mxCell><mxCell id="n12" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="138" y="516" width="22" height="22" as="geometry"/></mxCell><mxCell id="n13" value="&amp;lt;b&amp;gt;async-profiler&amp;lt;/b&amp;gt; — agent — where the time goes" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;spacingLeft=36;align=left;fontColor=#4C5A66;" vertex="1" parent="1"><mxGeometry x="130" y="550" width="500" height="34" as="geometry"/></mxCell><mxCell id="n14" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="138" y="556" width="22" height="22" as="geometry"/></mxCell><mxCell id="n15" value="&amp;lt;b&amp;gt;Arthas&amp;lt;/b&amp;gt; — attached — the values passed" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;spacingLeft=36;align=left;fontColor=#7038D8;" vertex="1" parent="1"><mxGeometry x="130" y="590" width="500" height="34" as="geometry"/></mxCell><mxCell id="n16" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="138" y="596" width="22" height="22" as="geometry"/></mxCell><mxCell id="n17" value="&amp;lt;b&amp;gt;The measurements&amp;lt;/b&amp;gt;&amp;#10;runs/&amp;#10;jacoco.exec · profil.collapsed · watch-params.txt&amp;#10;the only durable thing: everything else is derived from it" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="220" y="690" width="360" height="110" as="geometry"/></mxCell><mxCell id="n18" value="&amp;lt;b&amp;gt;The report&amp;lt;/b&amp;gt;&amp;#10;index.html · faits.jsonl · diagnostic.json&amp;#10;one file to open, no external resource" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="220" y="840" width="360" height="70" as="geometry"/></mxCell><mxCell id="n19" value="&amp;lt;b&amp;gt;Component cache&amp;lt;/b&amp;gt;&amp;#10;~/.runtime-xray" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="700" y="220" width="300" height="70" as="geometry"/></mxCell><mxCell id="n20" value="&amp;lt;b&amp;gt;Maven repository&amp;lt;/b&amp;gt;&amp;#10;or an internal mirror" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#F3F5F6;strokeColor=#8896A2;strokeWidth=1.6;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1100" y="220" width="260" height="70" as="geometry"/></mxCell><mxCell id="n21" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1112" y="236" width="32" height="32" as="geometry"/></mxCell><mxCell id="n22" value="starts a campaign&amp;#10;command line" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="launches the application, agents attached&amp;#10;JAVA_TOOL_OPTIONS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="write their outputs, each in its own format" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="read back and assembled — by the same jar&amp;#10;runtime-xray --report-only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="supplies the three tools" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n19" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="fills the cache, once — at install time&amp;#10;HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 5;" edge="1" parent="1" source="n20" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="&amp;lt;b&amp;gt;WHAT THIS DIAGRAM SAYS&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Three tools, three questions, and not one of them answers all three: it is their union that answers, and the orchestrator only lays it out.&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Everything that is read — the page, the facts, the diagnostic — is derived from runs/. Deleting the page loses nothing; deleting runs/ loses the measurement.&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;The network appears once, outside the zone, and at install time." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5B6873;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1090" y="380" width="300" height="260" as="geometry"/></mxCell><mxCell id="n29" value="SHAPES actor · service · application · storage · external · zone&amp;nbsp;&amp;nbsp;&amp;nbsp;COLOURS Files · Infrastructure · API and code&amp;nbsp;&amp;nbsp;&amp;nbsp;The subject of the diagram is outlined in magenta: the orchestrator." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#5B6873;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1000" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Reference use case"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="ONE RUN, MEASURED THREE TIMES OVER" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F2F5F6;strokeColor=#8896A2;strokeWidth=1.3;dashed=1;dashPattern=8 6;verticalAlign=top;align=right;spacingRight=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="420" height="320" as="geometry"/></mxCell><mxCell id="n3" value="&amp;lt;b&amp;gt;The analysed application&amp;lt;/b&amp;gt;&amp;#10;sample-app.jar&amp;#10;22 classes · no dependency · no clock, no randomness" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;spacingLeft=44;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="360" height="70" as="geometry"/></mxCell><mxCell id="n4" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="80" y="115" width="34" height="34" as="geometry"/></mxCell><mxCell id="n5" value="&amp;lt;b&amp;gt;The root method&amp;lt;/b&amp;gt;&amp;#10;RoutePlanner::travelTimeMinutes&amp;#10;named at launch — the only one whose values are captured" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#A3196F;strokeWidth=3.2;fontColor=#A3196F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="360" height="80" as="geometry"/></mxCell><mxCell id="n6" value="Deterministic: two runs produce the same trace.&amp;lt;br&amp;gt;Calibrated to ~10 s: long enough to attach to a live process.&amp;lt;br&amp;gt;Replayed under Java 21, then Java 25." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5B6873;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="380" height="70" as="geometry"/></mxCell><mxCell id="n7" value="&amp;lt;b&amp;gt;WHY THIS PROGRAM, AND NOT ANOTHER&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;It is built to tell tools apart:&amp;lt;br&amp;gt;· calls conditioned by the context&amp;lt;br&amp;gt;· two paths never taken — PlaneSpeed, the SNOW branch&amp;lt;br&amp;gt;· a recursion, so the call tree has real depth&amp;lt;br&amp;gt;· a virtual dispatch&amp;lt;br&amp;gt;· a blocking operation, so wall-clock and processor time diverge" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#5B6873;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="420" height="300" as="geometry"/></mxCell><mxCell id="n8" value="&amp;lt;b&amp;gt;JaCoCo&amp;lt;/b&amp;gt;&amp;#10;javaagent&amp;#10;&amp;#10;Says nothing about time, nor about the order of the calls." style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;spacingLeft=44;align=left;fontColor=#0B7A6E;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="300" height="100" as="geometry"/></mxCell><mxCell id="n9" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="80" y="444" width="32" height="32" as="geometry"/></mxCell><mxCell id="n10" value="jacoco.exec&amp;#10;inside runs/" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="450" y="446" width="220" height="68" as="geometry"/></mxCell><mxCell id="n11" value="&amp;lt;b&amp;gt;Which lines were executed&amp;lt;/b&amp;gt;&amp;#10;91.1 % of instructions, 81.8 % of branches · PlaneSpeed never loaded" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;align=left;spacingLeft=14;fontColor=#0B7A6E;" vertex="1" parent="1"><mxGeometry x="750" y="430" width="560" height="100" as="geometry"/></mxCell><mxCell id="n12" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="answers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&amp;lt;b&amp;gt;async-profiler&amp;lt;/b&amp;gt;&amp;#10;agentpath&amp;#10;&amp;#10;Samples: it can never prove that a piece of code did NOT run." style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;spacingLeft=44;align=left;fontColor=#4C5A66;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="300" height="100" as="geometry"/></mxCell><mxCell id="n15" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="80" y="574" width="32" height="32" as="geometry"/></mxCell><mxCell id="n16" value="profil.collapsed&amp;#10;inside runs/" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="450" y="576" width="220" height="68" as="geometry"/></mxCell><mxCell id="n17" value="&amp;lt;b&amp;gt;Where the time goes&amp;lt;/b&amp;gt;&amp;#10;71 % of the samples on business methods · the aggregated call tree" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;align=left;spacingLeft=14;fontColor=#4C5A66;" vertex="1" parent="1"><mxGeometry x="750" y="560" width="560" height="100" as="geometry"/></mxCell><mxCell id="n18" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="answers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="&amp;lt;b&amp;gt;Arthas&amp;lt;/b&amp;gt;&amp;#10;attach&amp;#10;&amp;#10;A console, not a report — and one method at a time." style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=0;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;spacingLeft=44;align=left;fontColor=#7038D8;" vertex="1" parent="1"><mxGeometry x="70" y="690" width="300" height="100" as="geometry"/></mxCell><mxCell id="n21" value="" style="shape=image;imageAspect=0;aspect=fixed;html=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="80" y="704" width="32" height="32" as="geometry"/></mxCell><mxCell id="n22" value="watch-params.txt&amp;#10;inside runs/" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="450" y="706" width="220" height="68" as="geometry"/></mxCell><mxCell id="n23" value="&amp;lt;b&amp;gt;Which values went through&amp;lt;/b&amp;gt;&amp;#10;Trip[id=TRIP-56, mode=CAR, weather=SUNNY] → 52.008… minutes" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#3E444A;strokeWidth=1.6;align=left;spacingLeft=14;fontColor=#7038D8;" vertex="1" parent="1"><mxGeometry x="750" y="690" width="560" height="100" as="geometry"/></mxCell><mxCell id="n24" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n20" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="answers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8896A2;strokeWidth=1.5;fontSize=11;fontColor=#5B6873;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="&amp;lt;b&amp;gt;None of the three answers the other two&#x27;s question.&amp;lt;/b&amp;gt;&amp;#10;That is the whole finding of the study: the answer is a combination, and what is left to settle is which second tool — not which one wins." style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181A;rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F2F5F6;strokeColor=#8896A2;strokeWidth=1.3;dashed=1;dashPattern=8 6;verticalAlign=top;align=right;spacingRight=12;spacingTop=6;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="70" y="830" width="1240" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
