<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    io.github.<account>: it is the only namespace one can prove ownership of without owning
    a domain — validation is done by proving the GitHub account. It is the shortest path to
    Maven Central, and it is final: a published artefact cannot be withdrawn, so the groupId
    cannot be corrected either.
  -->
  <groupId>io.github.beennnn</groupId>
  <artifactId>runtime-xray</artifactId>
  <version>1.2.2</version>
  <packaging>pom</packaging>

  <name>Runtime X-Ray</name>
  <description>
    Dynamic analysis of a Java run: the executed lines, the call tree and the parameter
    values, brought together in a single page. No licence, and no network access while it
    runs.
  </description>
  <url>https://github.com/Beennnn/runtime-xray</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>BSD Zero Clause License</name>
      <url>https://spdx.org/licenses/0BSD.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>beennnn</id>
      <name>Benoît Besson</name>
      <url>https://github.com/Beennnn</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/Beennnn/runtime-xray.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/Beennnn/runtime-xray.git</developerConnection>
    <url>https://github.com/Beennnn/runtime-xray</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/Beennnn/runtime-xray/issues</url>
  </issueManagement>

  <properties>
    <!-- 21 and not 25: the tool must run where the application runs, and a production
         machine is rarely on the latest version. The code uses nothing beyond it. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Pinned versions: a floating tag turns an upstream break into an unexplained build
         failure. -->
    <surefire.version>3.5.2</surefire.version>
    <jar.plugin.version>3.4.2</jar.plugin.version>
    <source.plugin.version>3.3.1</source.plugin.version>
    <javadoc.plugin.version>3.12.0</javadoc.plugin.version>
    <gpg.plugin.version>3.2.8</gpg.plugin.version>
    <central.plugin.version>0.11.0</central.plugin.version>

    <!-- The signing key. A single key on the machine makes this setting pointless, but
         naming it stops a second key, added one day for something else, from being picked
         without anybody noticing. -->
    <gpg.keyname>8D181AA1F3545E3C43804355D7D3E62B52C66FCA</gpg.keyname>
  </properties>

  <modules>
    <module>orchestrator</module>
    <module>sample-app</module>
    <!-- Les collecteurs par outil ne sont PAS des modules Maven : voir tools/README.md -->
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <profiles>
    <!--
      Publication to Maven Central. Isolated in a profile because it demands a signing key
      and credentials nobody has when cloning the repository: `mvn verify`
      doit rester possible sans rien configurer.

          mvn -Prelease deploy

      The human prerequisites — namespace validation, GPG key, credentials — are described
      in docs/outil/distribution.md.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${source.plugin.version}</version>
            <executions>
              <execution>
                <id>attacher-les-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${javadoc.plugin.version}</version>
            <configuration>
              <!-- The documentation is written to be read by humans rather than validated
                   by an HTML checker. doclint would block the publication over markup
                   details of no consequence. -->
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-the-javadoc</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${gpg.plugin.version}</version>
            <executions>
              <execution>
                <id>sign-the-artefacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!--
                    Neither a passphrase nor a forced "loopback" mode: on a machine, it is
                    the GPG agent that asks for it, and it then passes neither through Maven
                    nor through a variable. Forcing loopback amounts to cutting the agent out
                    and demanding the passphrase be supplied otherwise, that is to say making
                    it go where it has no need to go.

                    In continuous integration, where no agent can display a window, the
                    plugin reads MAVEN_GPG_PASSPHRASE from the environment (the
                    passphraseEnvName parameter). That is the path meant for it.
                  -->
                  <keyname>${gpg.keyname}</keyname>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central.plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- The deployment is staged but NOT published automatically: we read over
                   what goes out before making it final. A published version cannot be
                   withdrawn. -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
